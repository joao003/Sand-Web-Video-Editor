<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sand Web Video Editor</title>
    <script type="importmap"></script>
    <link rel="icon" type="image/x-icon" href="~/favicon2.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/editor.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SandWebVideoEditor.styles.css" asp-append-version="true" />
</head>
<body>
    <div>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-white" style="background: #000000; background: linear-gradient(153deg,rgba(0, 0, 0, 1) 0%, rgba(48, 48, 48, 1) 78%);">
        <div class="container">
            &copy; 2026 - Sand Web Video Editor
            <a href="https://github.com/joao003/Sand-Web-Video-Editor"><img src="~/githublogo.png" alt="GitHub" width="30" height="30" /></a>
        </div>
    </footer>
    <script src="_framework/blazor.webassembly.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
